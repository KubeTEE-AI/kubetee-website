---
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/global.css";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import { site } from "../content/site";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  activeHref?: string;
  sectionLinks?: ReadonlyArray<{ label: string; href: string }>;
  structuredData?: unknown;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  activeHref,
  sectionLinks,
  structuredData,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://kubetee.ai");
const canonicalUrl = canonicalPath ? new URL(canonicalPath, siteUrl).toString() : null;
const ogImageUrl = new URL("/logo.png", siteUrl).toString();
const structuredJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : null;
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang="en" data-scroll-behavior="smooth" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={site.name} />
    <meta name="author" content={site.legalName} />
    <meta name="creator" content={site.legalName} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Open Graph: small logo image plus description, by design. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="388" />
    <meta property="og:image:height" content="354" />
    <meta property="og:image:alt" content="KubeTEE" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@KubeTEEAI" />
    <meta name="twitter:creator" content="@KubeTEEAI" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      window.addEventListener("beforeinstallprompt", function (event) {
        event.preventDefault();
        window.__kubeteeInstallPrompt = event;
        window.dispatchEvent(new Event("kubetee-install-ready"));
      });
    </script>

    {structuredJson && <script type="application/ld+json" set:html={structuredJson}></script>}
  </head>
  <body class="flex min-h-full flex-col">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader activeHref={activeHref} />
    <slot />
    <SiteFooter sectionLinks={sectionLinks} />
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {
          // Installation is optional; a failed registration must not break the page.
        });
      }
    </script>
  </body>
</html>
