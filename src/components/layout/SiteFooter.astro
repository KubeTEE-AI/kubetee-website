---
import Container from "../ui/Container.astro";
import Logo from "../ui/Logo.astro";
import { footer, site } from "../../content/site";
import { isExternalHref } from "../../lib/links";

interface Props {
  sectionLinks?: ReadonlyArray<{ label: string; href: string }>;
}

const { sectionLinks } = Astro.props;

const updatedFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const lastUpdated = updatedFormatter.format(new Date(`${site.lastUpdated}T00:00:00.000Z`));
---

<footer class="border-t border-line bg-stage-deep">
  <Container class="py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Logo class="w-45" />
        <p class="mt-6 max-w-sm text-sm leading-6 text-muted">{footer.description}</p>
        <p class="text-xs mt-8 text-faint">{site.legalName} · Bittensor SN90</p>
      </div>

      <nav aria-label="Footer" class="lg:col-span-7">
        <ul class="grid grid-cols-2 gap-x-8 gap-y-3 text-sm">
          {footer.links.map((link) => {
            const external = isExternalHref(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="inline-flex min-h-8 items-center text-muted transition-colors hover:text-body"
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      {sectionLinks?.length ? (
        <nav aria-label="Page sections" class="border-t border-line pt-6 lg:col-span-12">
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {sectionLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-8 items-center text-muted transition-colors hover:text-body"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ) : null}
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-line pt-6 text-xs text-faint md:flex-row md:items-center md:justify-between">
      <p>
        © {site.lastUpdated.slice(0, 4)} {site.legalName}
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
        <span data-install-wrap hidden>
          <button
            type="button"
            data-install-app
            class="inline-flex min-h-9 items-center justify-center border border-line px-3 py-2 text-xs font-medium text-body transition-colors hover:border-brand/60 hover:text-brand"
          >
            Install app
          </button>
        </span>
        <p>Last updated {lastUpdated}</p>
      </div>
    </div>
  </Container>
</footer>

<script>
  const installWrap = document.querySelector<HTMLElement>("[data-install-wrap]");
  const installButton = document.querySelector<HTMLButtonElement>("[data-install-app]");

  if (installWrap && installButton) {
    const installWindow = window as Window & {
      __kubeteeInstallPrompt?: {
        prompt: () => Promise<void>;
        userChoice: Promise<{ outcome: "accepted" | "dismissed" }>;
      };
    };

    const syncInstall = () => {
      const available = Boolean(installWindow.__kubeteeInstallPrompt);
      const standalone = window.matchMedia("(display-mode: standalone)").matches;
      installWrap.hidden = !available || standalone;
    };

    window.addEventListener("kubetee-install-ready", syncInstall);
    window.addEventListener("appinstalled", () => {
      installWindow.__kubeteeInstallPrompt = undefined;
      syncInstall();
    });

    installButton.addEventListener("click", async () => {
      const prompt = installWindow.__kubeteeInstallPrompt;
      if (!prompt) return;
      try {
        await prompt.prompt();
        const choice = await prompt.userChoice;
        if (choice.outcome !== "accepted") {
          installWrap.hidden = true;
        }
      } catch {
        // The browser may have consumed the prompt already.
      } finally {
        installWindow.__kubeteeInstallPrompt = undefined;
        syncInstall();
      }
    });

    syncInstall();
  }
</script>
