---
import { dashboard } from "../../content/dashboard";
import {
  type Fill,
  formatAlpha,
  formatDate,
  formatDateRange,
  formatTao,
} from "../../lib/dashboard";
import AlphaText from "./AlphaText.astro";
import ExtrinsicLink from "./ExtrinsicLink.astro";
import MobileFill from "./MobileFill.astro";
import UsdValue from "./UsdValue.astro";

interface Props {
  fills: Fill[];
}

const { fills } = Astro.props;
const range = formatDateRange(fills[fills.length - 1]?.ts, fills[0]?.ts);
const recent = fills.slice(0, 10);
const older = fills.slice(10);
---

{fills.length === 0 ? (
  <div class="mt-8 border border-line p-6 text-sm text-muted">{dashboard.table.empty}</div>
) : (
  <>
    <div class="mt-8 hidden border border-line md:block">
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line px-4 py-3">
        <p class="label-mono text-faint">
          All {fills.length} fills · {range}
        </p>
        <p class="label-mono text-faint">USD = market estimate</p>
      </div>

      <table class="w-full border-separate border-spacing-0 text-[13px]">
        <caption class="sr-only">
          All {fills.length} SN28 to SN90 recycle fills, newest first, with dates in UTC.
        </caption>
        <thead>
          <tr>
            <th
              scope="col"
              class="sticky top-[72px] z-10 border-b border-line bg-stage-deep px-4 py-3 text-left label-mono text-faint"
            >
              {dashboard.table.date}
            </th>
            <th
              scope="col"
              class="sticky top-[72px] z-10 border-b border-line bg-stage-deep px-4 py-3 text-right label-mono text-faint"
            >
              <AlphaText text={dashboard.table.sn28} />
            </th>
            <th
              scope="col"
              class="sticky top-[72px] z-10 border-b border-line bg-stage-deep px-4 py-3 text-right label-mono text-faint"
            >
              <AlphaText text={dashboard.table.sn90} />
            </th>
            <th
              scope="col"
              class="sticky top-[72px] z-10 border-b border-line bg-stage-deep px-4 py-3 text-right label-mono text-faint"
            >
              {dashboard.table.tao}
            </th>
            <th
              scope="col"
              class="sticky top-[72px] z-10 border-b border-line bg-stage-deep px-4 py-3 text-right label-mono text-faint"
            >
              {dashboard.table.usd}
            </th>
            <th
              scope="col"
              class="sticky top-[72px] z-10 border-b border-line bg-stage-deep px-4 py-3 text-left label-mono text-faint"
            >
              {dashboard.table.extrinsic}
            </th>
          </tr>
        </thead>
        <tbody>
          {fills.map((fill) => (
            <tr class="transition-colors hover:bg-white/[0.02]">
              <td class="border-b border-line px-4 py-2.5 text-muted">
                <time datetime={fill.ts}>{formatDate(fill.ts)}</time>
              </td>
              <td class="border-b border-line px-4 py-2.5 text-right font-mono tabular-nums text-muted">
                {formatAlpha(fill.sn28Alpha)}
              </td>
              <td class="border-b border-line px-4 py-2.5 text-right font-mono tabular-nums text-body">
                {formatAlpha(fill.sn90Alpha)}
              </td>
              <td class="border-b border-line px-4 py-2.5 text-right font-mono tabular-nums text-muted">
                {formatTao(fill.taoValue)}
              </td>
              <td class="border-b border-line px-4 py-2.5 text-right font-mono tabular-nums text-body">
                <UsdValue value={fill.usdValue} />
              </td>
              <td class="border-b border-line px-4 py-2.5">
                <ExtrinsicLink fill={fill} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-8 md:hidden">
      <ul class="border-t border-line">
        {recent.map((fill) => (
          <MobileFill fill={fill} />
        ))}
      </ul>

      {older.length > 0 ? (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 border-b border-line py-4 label-mono text-faint [&::-webkit-details-marker]:hidden">
            <span>{`Show ${older.length} ${dashboard.table.mobileOlder}`}</span>
            <span
              aria-hidden="true"
              class="text-base leading-none text-brand transition-transform group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <ul>
            {older.map((fill) => (
              <MobileFill fill={fill} />
            ))}
          </ul>
        </details>
      ) : null}
    </div>

    <div class="mt-6 flex flex-col gap-3 border-t border-line pt-4 text-xs leading-5 text-faint md:flex-row md:items-start md:justify-between">
      <p class="max-w-[80ch]">
        {dashboard.table.note}{" "}
        <a
          href={dashboard.links.recycler}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted underline decoration-line underline-offset-2 transition-colors hover:text-body"
        >
          {dashboard.table.recyclerLink} <span aria-hidden="true">→</span>
        </a>
      </p>
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 font-mono text-[11px] uppercase tracking-[0.12em]">
        <span>{fills.length} fills · newest first · dates UTC</span>
        <a
          href={dashboard.links.rawJson}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted underline decoration-line underline-offset-2 transition-colors hover:text-body"
        >
          {dashboard.table.rawJson} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </>
)}
