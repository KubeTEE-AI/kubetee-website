---
import Container from "../ui/Container.astro";
import SectionLabel from "../ui/SectionLabel.astro";
import StatusTag from "../ui/StatusTag.astro";
import { coming } from "../../content/site";
---

<section id="coming" aria-labelledby="coming-title" class="border-b border-line py-20 md:py-28">
  <Container>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <SectionLabel number="05">{coming.kicker}</SectionLabel>
        <h2
          id="coming-title"
          class="mt-6 max-w-[16ch] text-[clamp(2.5rem,5vw,4.5rem)] font-light leading-[1.02] tracking-[-0.03em] text-body"
        >
          {coming.title}
        </h2>
      </div>
      <StatusTag />
    </div>

    <div class="mt-12 grid gap-px border border-line bg-line md:grid-cols-2">
      {coming.items.map((item) => (
        <article class="bg-stage-deep p-6 md:p-8">
          <h3 class="text-xl font-normal text-body">{item.title}</h3>
          <p class="mt-3 max-w-[48ch] text-sm leading-6 text-muted">{item.body}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
