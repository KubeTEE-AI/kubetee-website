---
import Container from "../ui/Container.astro";
import SectionLabel from "../ui/SectionLabel.astro";
import { pillars } from "../../content/site";
---

<section id="built" aria-labelledby="pillars-title" class="border-b border-line py-20 md:py-28">
  <Container>
    <SectionLabel number="02">{pillars.kicker}</SectionLabel>
    <h2
      id="pillars-title"
      class="mt-4 w-full text-[clamp(2.5rem,5vw,4.5rem)] font-light leading-[1.05] tracking-[-0.03em] text-body lg:w-1/2"
    >
      {pillars.title}
    </h2>
    <p class="mt-4 max-w-[60ch] text-sm leading-6 text-muted lg:max-w-[55ch]">{pillars.intro}</p>

    <div class="mt-10 grid gap-px border border-line bg-line md:grid-cols-2">
      {pillars.items.map((item) => (
        <article class="bg-stage p-6 md:p-8">
          <h3 class="text-xl font-normal text-body">{item.title}</h3>
          <p class="mt-4 max-w-[48ch] text-sm leading-6 text-muted">{item.body}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
