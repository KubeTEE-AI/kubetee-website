---
import IsoCube from "./IsoCube.astro";

type Variant = "rest" | "transit" | "use";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;

const copy = {
  rest: {
    title: "Encrypted storage at rest",
    description: "A closed cube with layered encrypted storage and a green sealed top.",
  },
  transit: {
    title: "Encrypted transport in transit",
    description:
      "Two cubes connected by a protected link, with a packet moving inside the confidential guest.",
  },
  use: {
    title: "Hardware-isolated execution in use",
    description: "A smaller green confidential guest sealed inside a dark host cube.",
  },
};

const id = `protection-${variant}`;
---

<svg
  viewBox="0 0 360 300"
  role="img"
  aria-labelledby={`${id}-title ${id}-desc`}
  class="h-auto w-full"
>
  <title id={`${id}-title`}>{copy[variant].title}</title>
  <desc id={`${id}-desc`}>{copy[variant].description}</desc>
  <ellipse cx="180" cy="266" rx="118" ry="14" fill="rgba(0,0,0,0.16)"></ellipse>

  {variant === "rest" && (
    <g>
      <IsoCube cx={180} top={55} size={82} />
      <g stroke="#83BB7B" stroke-width="5" stroke-linecap="square" opacity="0.75">
        <path d="M120 145L160 165" />
        <path d="M120 160L160 180" />
        <path d="M120 175L160 195" />
      </g>
    </g>
  )}

  {variant === "transit" && (
    <g>
      <path
        d="M120 140H240"
        fill="none"
        stroke="rgba(131,187,123,0.45)"
        stroke-width="1.5"
        stroke-dasharray="5 4"
        vector-effect="non-scaling-stroke"
      />
      <path
        d="M120 140H240"
        fill="none"
        stroke="#83BB7B"
        stroke-width="1.5"
        stroke-dasharray="40 80"
        stroke-dashoffset="-25"
        vector-effect="non-scaling-stroke"
      />
      <circle cx="180" cy="140" r="4" fill="#83BB7B" />
      <IsoCube cx={84} top={110} size={42} />
      <IsoCube cx={276} top={110} size={42} />
    </g>
  )}

  {variant === "use" && (
    <g>
      <IsoCube cx={180} top={40} size={86} />
      <IsoCube
        cx={180}
        top={126}
        size={38}
        topFill="#83BB7B"
        topOpacity={1}
        leftFill="#6DAA65"
        rightFill="#3E6B39"
      />
    </g>
  )}
</svg>
