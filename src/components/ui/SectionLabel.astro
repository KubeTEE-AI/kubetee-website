---
interface Props {
  number?: string;
  class?: string;
}

const { number, class: className } = Astro.props;
---

<p
  class:list={[
    "flex items-baseline gap-2 text-xs font-medium uppercase tracking-[0.14em] text-muted",
    className,
  ]}
>
  {number && (
    <>
      <span aria-hidden="true" class="tabular-nums text-faint">
        {number}
      </span>
      <span aria-hidden="true" class="text-faint">
        /
      </span>
    </>
  )}
  <span>
    <slot />
  </span>
</p>
