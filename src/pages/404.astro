---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
---

<Layout
  title="Page not found · KubeTEE"
  description="The page you requested does not exist."
  noindex
>
  <main id="main" class="flex-1 py-24 md:py-32">
    <Container>
      <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted">404</p>
      <h1 class="mt-6 max-w-[14ch] text-[clamp(3rem,7vw,6rem)] font-light leading-[0.98] tracking-[-0.04em] text-body">
        This page could not be found.
      </h1>
      <p class="mt-6 max-w-[52ch] text-base leading-7 text-muted">
        The page you requested does not exist. Return to the landing page or open the gateway.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/"
          class="inline-flex min-h-11 items-center justify-center bg-brand px-5 py-3 text-sm font-medium text-stage"
        >
          Back to KubeTEE
        </a>
        <a
          href="https://llm.kubetee.ai"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center border border-line px-5 py-3 text-sm font-medium text-body"
        >
          Open the Gateway
        </a>
      </div>
    </Container>
  </main>
</Layout>
