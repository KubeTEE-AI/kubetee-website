---
import Layout from "../layouts/Layout.astro";
import FillsLedger from "../components/dashboard/FillsLedger.astro";
import MetricStrip from "../components/dashboard/MetricStrip.astro";
import OperatorPanel from "../components/dashboard/OperatorPanel.astro";
import SwapValueChart from "../components/dashboard/SwapValueChart.astro";
import Container from "../components/ui/Container.astro";
import SectionLabel from "../components/ui/SectionLabel.astro";
import { dashboard } from "../content/dashboard";
import { site } from "../content/site";
import { dashboardSummary, formatDate } from "../lib/dashboard";
import { dashboardStructuredData } from "../lib/structured-data";

const summary = dashboardSummary;
const title = `${dashboard.meta.title} · ${site.name}`;
---

<Layout
  title={title}
  description={dashboard.meta.description}
  canonicalPath="/dashboard"
  activeHref="/dashboard"
  structuredData={dashboardStructuredData}
>
  <main id="main" class="flex-1">
    <section
      aria-labelledby="dashboard-title"
      class="border-b border-line pb-10 pt-8 md:pb-14 md:pt-10"
    >
      <Container>
        <SectionLabel number="01">{dashboard.header.kicker}</SectionLabel>
        <h1
          id="dashboard-title"
          class="mt-4 max-w-[34ch] text-[clamp(2.5rem,4.2vw,3.75rem)] font-light leading-[1.02] tracking-[-0.03em] text-body"
        >
          {dashboard.header.title}
        </h1>
        <p class="mt-5 max-w-[62ch] text-sm leading-6 text-muted md:text-base md:leading-7">
          {dashboard.header.intro}
        </p>

        <MetricStrip summary={summary} />
      </Container>
    </section>

    <section aria-labelledby="trend-title" class="border-b border-line py-10 md:py-14">
      <Container>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-8">
            <SectionLabel number="02">{dashboard.chart.kicker}</SectionLabel>
            <h2
              id="trend-title"
              class="mt-4 text-[clamp(1.5rem,2.2vw,2rem)] font-light leading-[1.1] tracking-[-0.02em] text-body"
            >
              {dashboard.chart.title}
            </h2>
            <p class="mt-2 text-sm text-muted">
              {dashboard.chart.subtitle} {formatDate(summary.window.end)}
            </p>

            <SwapValueChart summary={summary} />
          </div>

          <div class="border-t border-line pt-6 lg:col-span-4 lg:border-t-0 lg:border-l lg:border-line lg:pl-10 lg:pt-0">
            <OperatorPanel summary={summary} />
          </div>
        </div>
      </Container>
    </section>

    <section aria-labelledby="ledger-title" class="border-b border-line py-10 md:py-14">
      <Container>
        <SectionLabel number="03">{dashboard.table.kicker}</SectionLabel>
        <h2
          id="ledger-title"
          class="mt-4 text-[clamp(1.5rem,2.2vw,2rem)] font-light leading-[1.1] tracking-[-0.02em] text-body"
        >
          {dashboard.table.title}
        </h2>
        <p class="mt-4 max-w-[60ch] text-sm leading-6 text-muted">{dashboard.table.intro}</p>

        <FillsLedger fills={summary.fills} />
      </Container>
    </section>
  </main>
</Layout>
