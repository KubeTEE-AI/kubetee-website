---
import Layout from '../layouts/Layout.astro';

const title = 'KubeTEE — The Confidential AI Factory on Bittensor';
const description =
  'Decentralized GPU clusters turned into a secure factory for SOTA AI services — inference, agents, and batch jobs running inside hardware-secured Trusted Execution Environments.';

const pillars = [
  {
    title: 'Security-first TEE',
    body: 'Hardware-isolated Trusted Execution Environments on a FIPS-validated Kubernetes baseline, with remote attestation so the exact code running on your data can be verified.',
  },
  {
    title: 'Multi-cluster scheduling',
    body: 'One multi-cluster scheduler across decentralized GPU clusters — fair-use queuing, gang scheduling, and preemption, so large jobs place without starving the fleet.',
  },
  {
    title: 'SOTA AI services',
    body: 'NVIDIA NeMo microservices, NIM models, and AI Blueprints as first-class confidential services — plus Bittensor subnet integrations where the NVIDIA stack falls short.',
  },
  {
    title: 'Decentralized & open',
    body: 'One identity per cluster, nodes in distinct data centers, expanding across global regions. Built on open-source projects; our patches live in public forks and go upstream.',
  },
];

const liveToday = [
  {
    title: 'Confidential inference gateway',
    body: 'OpenAI-compatible inference at llm.kubetee.ai — GLM-5.2, GLM-5.3-Flash, Ornith-1.5-397B, and DeepSeek-V4-Flash, served inside TEE-isolated pods.',
    link: 'https://llm.kubetee.ai',
    linkLabel: 'llm.kubetee.ai',
  },
  {
    title: 'Real external revenue',
    body: 'External inference demand is already paying for compute — and that revenue is recycled on-chain every day.',
  },
  {
    title: 'Validator on Bittensor mainnet',
    body: 'The validator is live on Finney with a public dashboard showing per-cluster infrastructure readiness and scoring.',
    link: 'https://s3.hippius.com/kubetee-validator/index.html',
    linkLabel: 'Validator dashboard',
  },
  {
    title: 'TEE-capable staging cluster',
    body: 'Every node on the staging cluster is confidential-computing capable — running the same TEE runtime classes as production miner clusters.',
  },
];

const coming = [
  {
    title: 'Permissionless miner onboarding',
    body: 'Miners register their own cluster and prove control of their hardware without operator involvement.',
  },
  {
    title: 'Multi-cluster batch scheduling',
    body: 'Fine-tuning, evaluation, and multi-step pipelines dispatched across decentralized clusters as confidential batch jobs.',
  },
  {
    title: 'Agent- and chat-driven job deployment',
    body: 'Deploy compute from an autonomous agent or a chat client — browse the catalogue, get a quote, submit, and track the job to completion.',
  },
  {
    title: 'USDC and TAO billing',
    body: 'Pay for confidential compute in stablecoins or TAO, alongside subnet-native Alpha.',
  },
];
---

<Layout title={title} description={description}>
  <header>
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="KubeTEE home">
        <img src="/brand/logos/svg/Logo-7.svg" alt="KubeTEE" width="140" height="30" />
      </a>
      <nav aria-label="Primary">
        <a href="#live">Live today</a>
        <a href="#coming">Coming</a>
        <a
          href="https://github.com/KubeTEE-AI"
          class="nav-github"
          rel="noopener"
          target="_blank"
        >
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <h1>The Confidential<br /><span class="accent">AI Factory</span> on Bittensor</h1>
        <p class="hero-sub">
          Decentralized GPU clusters turned into a secure factory for SOTA AI
          services — inference, agents, and batch jobs inside hardware-secured
          Trusted Execution Environments.
        </p>
        <div class="hero-cta">
          <a href="https://llm.kubetee.ai" class="btn btn-primary" rel="noopener">
            Try the gateway
          </a>
          <a
            href="https://github.com/KubeTEE-AI/kubetee-subnet"
            class="btn btn-secondary"
            rel="noopener"
          >
            Read the code
          </a>
        </div>
      </div>
    </section>

    <section id="what" class="what">
      <div class="container">
        <span class="section-label">What is KubeTEE</span>
        <h2>An AI factory, run where no one can read your data</h2>
        <div class="what-grid">
          <p>
            KubeTEE is the AI Factory of the Bittensor network. It turns
            decentralized GPU clusters into a confidential factory for
            state-of-the-art AI services — inference, model microservices,
            retrieval, and agents.
          </p>
          <p>
            Every service runs inside a hardware-secured Trusted Execution
            Environment: the host cannot read workload memory, and remote
            attestation proves the code and configuration are unmodified. Data
            and models are protected at rest, in transit, and in use.
          </p>
          <p>
            The whole stack is open source, built on Kata Containers,
            Confidential Containers, and a FIPS-validated Kubernetes baseline.
            Where we patch upstream projects, the patches live in public forks
            and are contributed back.
          </p>
        </div>
      </div>
    </section>

    <section id="pillars" class="pillars">
      <div class="container">
        <span class="section-label">How it's built</span>
        <h2>Four pillars</h2>
        <div class="pillar-grid">
          {
            pillars.map((p) => (
              <article class="pillar-card">
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="live" class="live">
      <div class="container">
        <span class="section-label">Live today</span>
        <h2>Running now, not a whitepaper</h2>
        <ul class="live-list">
          {
            liveToday.map((item) => (
              <li class="live-item">
                <span class="live-dot" aria-hidden="true" />
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  {item.link && (
                    <a href={item.link} class="live-link" rel="noopener">
                      {item.linkLabel}
                      <span aria-hidden="true"> &rarr;</span>
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="coming" class="coming">
      <div class="container">
        <span class="section-label">Coming</span>
        <h2>What we're building next</h2>
        <div class="coming-grid">
          {
            coming.map((item) => (
              <article class="coming-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-inner">
      <div class="footer-brand">
        <img
          src="/brand/logos/svg/Logo-7.svg"
          alt="KubeTEE"
          width="120"
          height="26"
        />
        <p>
          Confidential compute for SOTA AI services — secured by TEE, incentivized
          by Bittensor.
        </p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://llm.kubetee.ai" rel="noopener">Gateway</a>
        <a href="https://s3.hippius.com/kubetee-validator/index.html" rel="noopener">
          Validator dashboard
        </a>
        <a href="https://github.com/KubeTEE-AI" rel="noopener">GitHub</a>
        <a href="https://x.com/KubeTEEAI" rel="noopener">X</a>
      </nav>
    </div>
    <div class="container footer-note">
      <p>© {new Date().getFullYear()} KubeTEE AI</p>
    </div>
  </footer>
</Layout>

<style>
  /* Header */
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(14, 17, 22, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand img {
    filter: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    color: var(--text-muted);
  }

  nav a:hover {
    color: var(--text);
  }

  .nav-github {
    color: var(--accent);
  }

  .nav-github:hover {
    color: var(--accent-strong);
  }

  /* Hero */
  .hero {
    padding: 120px 0 100px;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(38px, 6.5vw, 64px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  .hero .accent {
    color: var(--accent);
  }

  .hero-sub {
    font-size: clamp(16px, 2vw, 19px);
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 auto 40px;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: #0b1a09;
  }

  .btn-primary:hover {
    background: var(--accent-strong);
  }

  .btn-secondary {
    border-color: var(--border);
    color: var(--text);
  }

  .btn-secondary:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }

  /* What is */
  .what {
    background: var(--bg-elevated);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .what-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
    margin-top: 32px;
  }

  .what-grid p {
    color: var(--text-muted);
    font-size: 16px;
  }

  /* Pillars */
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 36px;
  }

  .pillar-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px 24px;
    transition: border-color 0.15s ease;
  }

  .pillar-card:hover {
    border-color: var(--accent-border);
  }

  .pillar-card h3 {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--text);
  }

  .pillar-card p {
    font-size: 14.5px;
    color: var(--text-muted);
  }

  /* Live today */
  .live {
    background: var(--bg-elevated);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .live-list {
    list-style: none;
    margin-top: 36px;
    display: grid;
    gap: 24px;
  }

  .live-item {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  .live-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 8px;
    box-shadow: 0 0 0 4px var(--accent-subtle);
  }

  .live-item h3 {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .live-item p {
    color: var(--text-muted);
    font-size: 15px;
    max-width: 640px;
  }

  .live-link {
    display: inline-block;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .live-link:hover {
    color: var(--accent-strong);
  }

  /* Coming */
  .coming-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 36px;
  }

  .coming-card {
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 28px 24px;
  }

  .coming-card h3 {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .coming-card p {
    font-size: 14.5px;
    color: var(--text-muted);
  }

  /* Footer */
  footer {
    border-top: 1px solid var(--border);
    padding: 48px 0 32px;
    margin-top: 40px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    flex-wrap: wrap;
  }

  .footer-brand p {
    color: var(--text-faint);
    font-size: 14px;
    margin-top: 14px;
    max-width: 340px;
  }

  .footer-links {
    display: flex;
    gap: 28px;
    font-size: 14.5px;
    color: var(--text-muted);
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-note {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .footer-note p {
    font-size: 13px;
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 80px 0 64px;
    }

    .footer-inner {
      flex-direction: column;
    }
  }
</style>
